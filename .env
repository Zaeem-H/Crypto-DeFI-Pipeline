# PostgreSQL connection parameters for the Gold layer data warehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto_pipeline
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Apache Kafka broker and topic configurations for the Bronze layer
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_MARKET=crypto.market.coincap
KAFKA_TOPIC_TRENDING=crypto.market.trending
KAFKA_TOPIC_TVL=crypto.defi.tvl

# Apache Airflow environment and metadata database configuration
AIRFLOW_UID=50000
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/crypto_pipeline

# Authorisation credentials for external cryptocurrency and DeFi API providers
COINCAP_API_KEY=ADD_API_KEY
COINGECKO_API_KEY=ADD_API_KEY