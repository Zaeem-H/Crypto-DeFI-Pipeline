# Use a Python image 
FROM python:3.8

# Set the working directory inside the container
WORKDIR /app

# Install ONLY the 3 lightweight packages the Producers need
# (No requirements.txt needed!)
RUN pip install --no-cache-dir kafka-python requests python-dotenv

# Copy the rest of your project code into the container
COPY . .

# Set Python path so it knows where the 'src' folder is
ENV PYTHONPATH=/app

# The command to run the specific producer is passed via docker-compose.yaml!